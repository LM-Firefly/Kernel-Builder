{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "release", "defaultKernel", "abi", "shellAbi", "template", "toolchain", "kernels"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "release": {
      "type": "object",
      "required": ["tag", "url", "manifestUrl"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "manifestUrl": { "type": "string", "format": "uri" }
      }
    },
    "defaultKernel": { "const": "alpha" },
    "shellAbi": { "type": "integer", "minimum": 1 },
    "abi": { "const": "arm64-v8a" },
    "template": {
      "type": "object",
      "required": ["repository", "ref"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "required": ["go", "ndk", "compression", "compressionLevel"],
      "properties": {
        "go": { "type": "string", "minLength": 1 },
        "ndk": { "type": "string", "minLength": 1 },
        "compression": { "const": "xz" },
        "compressionLevel": { "type": "integer", "minimum": 0, "maximum": 9 }
      }
    },
    "kernels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "commit", "abi", "shellAbi", "asset", "downloadUrl", "checksumUrl", "sha256", "sizeBytes", "compression", "sourceRepository", "sourceRef", "sourceCommit", "templateCommit"],
        "properties": {
          "id": { "enum": ["alpha", "meta", "smart"] },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "abi": { "const": "arm64-v8a" },
          "shellAbi": { "type": "integer", "minimum": 1 },
          "asset": { "type": "string", "pattern": "^libmihomocore-[a-z0-9-]+-arm64-v8a\\.so\\.xz$" },
          "downloadUrl": { "type": "string", "format": "uri" },
          "checksumUrl": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "compression": { "const": "xz" },
          "sourceRepository": { "type": "string", "minLength": 1 },
          "sourceRef": { "type": "string", "minLength": 1 },
          "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "templateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  }
}
