{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YumeBox Kernel Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "release", "builder", "defaultKernel", "abi", "shellAbi", "template", "toolchain", "kernels"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tag", "url", "manifestUrl"],
      "properties": {
        "kind": { "enum": ["official", "custom"] },
        "tag": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "manifestUrl": { "type": "string", "format": "uri" },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset", "downloadUrl"],
          "properties": {
            "asset": { "const": "kernel-plugin.zip" },
            "downloadUrl": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "runId", "commit", "format"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "workflow": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "format": { "enum": ["kernel-release-v1", "kernel-plugin-v1"] }
      }
    },
    "defaultKernel": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "shellAbi": { "type": "integer", "minimum": 1 },
    "abi": { "const": "arm64-v8a" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go", "ndk", "compression", "compressionLevel"],
      "properties": {
        "go": { "type": "string", "minLength": 1 },
        "ndk": { "type": "string", "minLength": 1 },
        "compression": { "const": "xz" },
        "compressionLevel": { "type": "integer", "minimum": 0, "maximum": 9 }
      }
    },
    "kernels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "commit", "abi", "shellAbi", "asset", "downloadUrl", "sha256", "sizeBytes", "compression", "capabilities", "sourceRepository", "sourceRef", "sourceCommit", "templateCommit"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "abi": { "const": "arm64-v8a" },
          "shellAbi": { "type": "integer", "minimum": 1 },
          "asset": { "type": "string", "pattern": "^kernel-[a-z0-9][a-z0-9-]*\\.so\\.xz$" },
          "downloadUrl": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "compression": { "const": "xz" },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "sourceRepository": { "type": "string", "minLength": 1 },
          "sourceRef": { "type": "string", "minLength": 1 },
          "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "templateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  }
}
