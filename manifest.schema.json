{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "shellAbi", "releaseTag", "generatedAt", "kernels"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "shellAbi": { "type": "integer", "minimum": 1 },
    "releaseTag": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "kernels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel", "label", "abi", "asset", "sha256", "commit", "version"],
        "properties": {
          "channel": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "abi": { "type": "string", "minLength": 1 },
          "asset": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "commit": { "type": "string", "minLength": 4 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
