# Copy this file to .env to change the public build configuration.
# Do not put access tokens here. Use TEMPLATE_REPOSITORY_TOKEN and
# KERNEL_REPOSITORY_TOKEN as GitHub Actions secrets for private repositories.
TEMPLATE_REPOSITORY=YumeYucca/YumeBox
TEMPLATE_REF=Moe
ANDROID_NDK_VERSION=30.0.14904198
ANDROID_MIN_SDK=26
ANDROID_ABI=arm64-v8a
JAVA_VERSION=24
GO_VERSION=1.26
GO_DOWNLOAD_BASE_URL=https://github.com/MetaCubeX/go/releases/download/build
RELEASE_TAG=kernel
RELEASE_NAME=Build Kernel
RELEASE_PRERELEASE=true
RELEASE_MAKE_LATEST=false
COMPRESSION=xz
COMPRESSION_LEVEL=9
